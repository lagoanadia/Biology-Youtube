{
 "total": 26.9,
 "planned": false,
 "beats": [
  {
   "text": "This mole eats faster than any other mammal.",
   "visual": "hook",
   "start": 0.0,
   "end": 2.518
  },
  {
   "text": "It can find and eat small prey in less than a quarter of a second.",
   "visual": "fast",
   "start": 2.518,
   "end": 5.895
  },
  {
   "text": "The secret is on its face.",
   "visual": "face",
   "start": 5.895,
   "end": 7.566
  },
  {
   "text": "A pink star of twenty-two tentacles.",
   "visual": "star",
   "start": 7.566,
   "end": 9.868
  },
  {
   "text": "They're covered in over twenty-five thousand touch sensors.",
   "visual": "sensors",
   "start": 9.868,
   "end": 13.093
  },
  {
   "text": "It taps the ground up to twelve times every second.",
   "visual": "tap",
   "start": 13.093,
   "end": 15.943
  },
  {
   "text": "And it even hunts underwater.",
   "visual": "swim",
   "start": 15.943,
   "end": 17.579
  },
  {
   "text": "It blows bubbles onto its prey and sniffs them back in.",
   "visual": "bubbles",
   "start": 17.579,
   "end": 20.883
  },
  {
   "text": "That's how it smells underwater.",
   "visual": "smell",
   "start": 20.883,
   "end": 22.741
  },
  {
   "text": "Then the star finds the next snack.",
   "visual": "loop",
   "start": 22.741,
   "end": 26.9
  }
 ],
