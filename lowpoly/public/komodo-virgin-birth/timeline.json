 "beats": [
  {
   "text": "This baby dragon has no father.",
   "visual": "hook",
   "start": 0.0,
   "end": 2.03
  },
  {
   "text": "In 2006, a female at a British zoo laid eggs.",
   "visual": "zoo",
   "start": 2.03,
   "end": 5.73
  },
  {
   "text": "But no male had been near her.",
   "visual": "nomale",
   "start": 5.73,
   "end": 7.381
  },
  {
   "text": "Then the eggs hatched.",
   "visual": "hatch",
   "start": 7.381,
   "end": 8.728
  },
  {
   "text": "DNA showed the babies came only from their mother.",
   "visual": "dna",
   "start": 8.728,
   "end": 11.616
  },
  {
   "text": "Half her chromosomes doubled up to make each one.",
   "visual": "chromo",
   "start": 11.616,
   "end": 14.318
  },
  {
   "text": "And every single baby was a boy.",
   "visual": "boys",
   "start": 14.318,
   "end": 16.377
  },
  {
   "text": "Scientists think this helps a female stranded alone on an island.",
   "visual": "island",
   "start": 16.377,
   "end": 20.165
  },
  {
   "text": "She can still start a family.",
   "visual": "family",
   "start": 20.165,
   "end": 21.737
  },
  {
   "text": "That's how a baby dragon ends up with no father.",
   "visual": "loop",
   "start": 21.737,
   "end": 26.8
  }
 ],
