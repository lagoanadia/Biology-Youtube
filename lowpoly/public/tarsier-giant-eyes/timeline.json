{
 "total": 24.2,
 "planned": false,
 "beats": [
  {
   "text": "Each of this animal's eyes is about as big as its brain.",
   "visual": "hook",
   "start": 0.0,
   "end": 3.007
  },
  {
   "text": "But it can't move its eyes at all.",
   "visual": "fixed",
   "start": 3.007,
   "end": 4.987
  },
  {
   "text": "So it turns its head halfway around instead.",
   "visual": "turn",
   "start": 4.987,
   "end": 7.418
  },
  {
   "text": "It lives in the forests of the Philippines.",
   "visual": "forest",
   "start": 7.418,
   "end": 9.76
  },
  {
   "text": "And it only comes out at night.",
   "visual": "night",
   "start": 9.76,
   "end": 11.333
  },
  {
   "text": "Those giant eyes spot insects in the dark.",
   "visual": "spot",
   "start": 11.333,
   "end": 13.953
  },
  {
   "text": "Then it leaps from branch to branch to grab them.",
   "visual": "leap",
   "start": 13.953,
   "end": 16.903
  },
  {
   "text": "It even calls out in screams we can't hear.",
   "visual": "ultrasound",
   "start": 16.903,
   "end": 19.565
  },
  {
   "text": "And with those eyes it's already watching you.",
   "visual": "loop",
   "start": 19.565,
   "end": 24.2
  }
 ],
