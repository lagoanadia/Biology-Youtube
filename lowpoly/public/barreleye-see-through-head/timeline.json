 "beats": [
  {
   "text": "Those two dots aren't its eyes.",
   "visual": "hook",
   "start": 0.0,
   "end": 1.77
  },
  {
   "text": "They're its nostrils.",
   "visual": "nostrils",
   "start": 1.77,
   "end": 2.989
  },
  {
   "text": "Its real eyes are the green domes inside its see-through head.",
   "visual": "reveal",
   "start": 2.989,
   "end": 6.407
  },
  {
   "text": "Its head is covered by a clear shield full of fluid.",
   "visual": "shield",
   "start": 6.407,
   "end": 9.59
  },
  {
   "text": "It hangs almost still, six hundred meters down.",
   "visual": "depth",
   "start": 9.59,
   "end": 12.821
  },
  {
   "text": "Its eyes point up to spot the shadows of prey above.",
   "visual": "lookup",
   "start": 12.821,
   "end": 16.015
  },
  {
   "text": "Then they rotate forward so it can see what it eats.",
   "visual": "rotate",
   "start": 16.015,
   "end": 18.857
  },
  {
   "text": "So next time it stares at you, look higher.",
   "visual": "loop",
   "start": 18.857,
   "end": 23.5
  }
 ],
