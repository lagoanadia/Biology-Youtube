{
 "total": 25.57,
 "planned": false,
 "beats": [
  {
   "text": "That broken branch is actually a bird.",
   "visual": "hook",
   "start": 0.0,
   "end": 2.304
  },
  {
   "text": "All day it sits perfectly still, high up in a tree.",
   "visual": "still",
   "start": 2.304,
   "end": 5.288
  },
  {
   "text": "When danger comes, it points its beak to the sky.",
   "visual": "point",
   "start": 5.288,
   "end": 7.837
  },
  {
   "text": "Now it looks exactly like a broken branch.",
   "visual": "branch",
   "start": 7.837,
   "end": 10.273
  },
  {
   "text": "Its eyes are closed, but it's still watching.",
   "visual": "eyes",
   "start": 10.273,
   "end": 12.842
  },
  {
   "text": "Tiny slits in its eyelids let it sense movement.",
   "visual": "slits",
   "start": 12.842,
   "end": 15.567
  },
  {
   "text": "Then night falls and the branch wakes up.",
   "visual": "night",
   "start": 15.567,
   "end": 17.721
  },
  {
   "text": "It flies out and opens a huge mouth.",
   "visual": "mouth",
   "start": 17.721,
   "end": 20.181
  },
  {
   "text": "Big flying insects disappear inside.",
   "visual": "gulp",
   "start": 20.181,
   "end": 22.706
  },
  {
   "text": "By sunrise it's a broken branch again.",
   "visual": "loop",
   "start": 22.706,
   "end": 25.57
  }
 ],
