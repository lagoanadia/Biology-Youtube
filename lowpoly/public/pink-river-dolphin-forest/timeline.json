 "beats": [
  {
   "text": "This dolphin swims through a forest.",
   "visual": "hook",
   "start": 0.0,
   "end": 2.161
  },
  {
   "text": "Every year the Amazon River floods the jungle.",
   "visual": "flood",
   "start": 2.161,
   "end": 4.944
  },
  {
   "text": "And pink river dolphins follow the water between the trees.",
   "visual": "trees",
   "start": 4.944,
   "end": 8.224
  },
  {
   "text": "Their neck bones aren't fused together.",
   "visual": "neck",
   "start": 8.224,
   "end": 10.249
  },
  {
   "text": "So they can bend their heads up to ninety degrees.",
   "visual": "bend",
   "start": 10.249,
   "end": 12.795
  },
  {
   "text": "That lets them twist around trunks and branches to catch fish.",
   "visual": "hunt",
   "start": 12.795,
   "end": 16.112
  },
  {
   "text": "And the pink color?",
   "visual": "pink",
   "start": 16.112,
   "end": 17.259
  },
  {
   "text": "Scientists think it comes from scars.",
   "visual": "scars",
   "start": 17.259,
   "end": 19.578
  },
  {
   "text": "Males get them from rough play and fights.",
   "visual": "fight",
   "start": 19.578,
   "end": 22.076
  },
  {
   "text": "Next time the river rises, look between the trees.",
   "visual": "loop",
   "start": 22.076,
   "end": 27.2
  }
 ],
