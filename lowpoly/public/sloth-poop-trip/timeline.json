{
 "total": 24.9,
 "planned": false,
 "beats": [
  {
   "text": "Once a week this sloth risks its life just to poop.",
   "visual": "hook",
   "start": 0.0,
   "end": 2.952
  },
  {
   "text": "It climbs all the way down from the treetops.",
   "visual": "climb",
   "start": 2.952,
   "end": 5.453
  },
  {
   "text": "On the ground it's an easy target.",
   "visual": "ground",
   "start": 5.453,
   "end": 7.423
  },
  {
   "text": "Scientists think the reason is tiny moths in its fur.",
   "visual": "moths",
   "start": 7.423,
   "end": 10.906
  },
  {
   "text": "The moths lay their eggs in sloth poop.",
   "visual": "eggs",
   "start": 10.906,
   "end": 13.429
  },
  {
   "text": "New moths fly up and move into the fur.",
   "visual": "flyup",
   "start": 13.429,
   "end": 15.823
  },
  {
   "text": "They help green algae grow on the sloth.",
   "visual": "algae",
   "start": 15.823,
   "end": 18.253
  },
  {
   "text": "And the sloth eats that algae as a snack.",
   "visual": "snack",
   "start": 18.253,
   "end": 20.787
  },
  {
   "text": "So next week it climbs down again.",
   "visual": "loop",
   "start": 20.787,
   "end": 24.9
  }
 ],
