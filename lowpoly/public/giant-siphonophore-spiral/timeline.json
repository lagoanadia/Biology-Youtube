{
 "total": 27.5,
 "planned": false,
 "beats": [
  {
   "text": "Scientists filmed a creature longer than a blue whale.",
   "visual": "hook",
   "start": 0.0,
   "end": 3.05
  },
  {
   "text": "And it was coiled into a giant spiral.",
   "visual": "spiral",
   "start": 3.05,
   "end": 5.268
  },
  {
   "text": "A robot found it in deep canyons off Western Australia in 2020.",
   "visual": "rov",
   "start": 5.268,
   "end": 9.5
  },
  {
   "text": "Its outer ring alone was estimated at forty-seven meters.",
   "visual": "measure",
   "start": 9.5,
   "end": 13.079
  },
  {
   "text": "Scientists think that spiral is a hunting trap.",
   "visual": "trap",
   "start": 13.079,
   "end": 15.985
  },
  {
   "text": "It works like a drift net that sweeps up food.",
   "visual": "net",
   "start": 15.985,
   "end": 18.588
  },
  {
   "text": "Tiny animals that drift into it get caught.",
   "visual": "catch",
   "start": 18.588,
   "end": 21.071
  },
  {
   "text": "It doesn't even need to chase its food.",
   "visual": "wait",
   "start": 21.071,
   "end": 23.18
  },
  {
   "text": "It just hangs in the dark and waits.",
   "visual": "loop",
   "start": 23.18,
   "end": 27.5
  }
 ],
