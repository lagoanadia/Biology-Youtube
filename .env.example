# Copia este fichero a .env y rellena tus claves. NUNCA subas .env a GitHub.
ANTHROPIC_API_KEY=sk-ant-...
# Opcional: imágenes libres extra (https://www.pexels.com/api/)
PEXELS_API_KEY=
# Rutas de credenciales de Google (OAuth "Desktop app")
YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# Opcional: CA propia si estás detrás de un proxy corporativo
BIOTUBE_CA_BUNDLE=
